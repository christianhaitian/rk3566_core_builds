+/* MINILOONG Pocket1 Vulkan-only display orientation quirk.
+ *
+ * The built-in LCD is a native 720x960 portrait panel, while dArkOS uses
+ * RetroArch in landscape orientation. GLES already handles this correctly on
+ * this device, so keep this correction local to the Vulkan video driver.
+ *
+ * HDMI is intentionally excluded: if any DRM HDMI connector is connected,
+ * use stock RetroArch Vulkan orientation.
+ */
+static bool vulkan_miniloong_internal_panel(void)
+{
+   FILE *file;
+   char device[128];
+   DIR *dir;
+   struct dirent *entry;
+   bool is_miniloong = false;
+
+   file = fopen("/home/ark/.config/.DEVICE", "r");
+   if (!file)
+      return false;
+
+   if (fgets(device, sizeof(device), file) && strstr(device, "MINILOONG"))
+      is_miniloong = true;
+
+   fclose(file);
+
+   if (!is_miniloong)
+      return false;
+
+   dir = opendir("/sys/class/drm");
+   if (dir)
+   {
+      while ((entry = readdir(dir)) != NULL)
+      {
+         char status_path[512];
+         char status[32];
+
+         if (!strstr(entry->d_name, "HDMI"))
+            continue;
+
+         snprintf(status_path, sizeof(status_path),
+               "/sys/class/drm/%s/status", entry->d_name);
+
+         file = fopen(status_path, "r");
+         if (!file)
+            continue;
+
+         if (fgets(status, sizeof(status), file))
+         {
+            status[strcspn(status, "\r\n")] = '\0';
+            if (strcmp(status, "connected") == 0)
+            {
+               fclose(file);
+               closedir(dir);
+               return false;
+            }
+         }
+
+         fclose(file);
+      }
+      closedir(dir);
+   }
+
+   return true;
+}
