 /**
  * libretro callback; Called every game tick.
  */
+#ifdef __linux__
+/// dArkOS: whether the RG52 Mini's Back key is down. It is BTN_TRIGGER_HAPPY1 of the built-in
+/// pad, which the RetroPad has no button for, so it is read from the pad's event device
+/// (EVIOCGKEY only reads the state: RetroArch still gets every event).
+static bool BackKeyDown() {
+    static int fd = -2;
+    if (fd == -2) {
+        fd = -1;
+        for (int n = 0; n < 32 && fd < 0; n++) {
+            char path[64], name[64] = {};
+            snprintf(path, sizeof(path), "/sys/class/input/event%d/device/name", n);
+            FILE* f = fopen(path, "r");
+            if (!f)
+                continue;
+            const bool pad = fgets(name, sizeof(name), f) &&
+                             strncmp(name, "retrogame_joypad", strlen("retrogame_joypad")) == 0;
+            fclose(f);
+            if (pad) {
+                snprintf(path, sizeof(path), "/dev/input/event%d", n);
+                fd = open(path, O_RDONLY | O_NONBLOCK | O_CLOEXEC);
+            }
+        }
+    }
+    if (fd < 0)
+        return false;
+    unsigned char keys[KEY_MAX / 8 + 1] = {};
+    if (ioctl(fd, EVIOCGKEY(sizeof(keys)), keys) < 0)
+        return false;
+    return (keys[BTN_MODE / 8] >> (BTN_MODE % 8)) & 1;
+}
+#else
+static bool BackKeyDown() {
+    return false;
+}
+#endif
+
